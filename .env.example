# Live mode only. Demo mode needs none of these. Never commit a filled-in copy (.env* is git-ignored).
# Turn sources on/off in config.json -> sources; only the switched-on ones are required.
GONG_ACCESS_KEY=
GONG_ACCESS_KEY_SECRET=
GONG_BASE_URL=                       # your tenant's API host, from Gong > Settings > API
OUR_DOMAINS=                         # e.g. ourco.com: places Gong 'Unknown' speakers by email domain
SF_INSTANCE_URL=https://yourorg.my.salesforce.com
SF_CLIENT_ID=                        # connected app, client-credentials flow (fresh token every run)
SF_CLIENT_SECRET=
SF_ACCESS_TOKEN=                     # alternative to the two above, for a one-off run
SF_RENEWAL_FIELD=Renewal_Date__c
SF_CUSTOMER_TYPES=Customer,Customer - Direct,Customer - Channel
SF_INTEGRATION_USER_ID=               # the run-as user's Id (005...): its own Tasks are never read back as rep notes
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=                     # app-level token with connections:write (Socket Mode)
PIPELINE_MODE=demo                   # the Slack app's runs: set to live once `python3 -m pg_system --check` passes
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_ROLE=
SNOWFLAKE_PRIVATE_KEY_FILE=          # key-pair auth (password sign-in is being retired for service users)
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_PASSWORD=                  # only if key-pair is not set up
PEOPLE_MATCH_URL=                    # name + company match (step 1)
PEOPLE_SEARCH_URL=                   # same-name search, 50 deep (step 2, misses only)
PEOPLE_PROFILE_URL=                  # optional: one profile by URL, for "Paste the right profile" (else name + URL only)
PEOPLE_DATA_TOKEN=
# Optional model observer for the brief (config.json -> observer.enabled). Paid calls: off by default.
OBSERVER_PROVIDER=anthropic          # anthropic or openai (any OpenAI-compatible chat completions API)
OBSERVER_MODEL=                      # anthropic: optional (default claude-haiku-5-5); openai: required
ANTHROPIC_API_KEY=                   # when OBSERVER_PROVIDER=anthropic
OPENAI_API_KEY=                      # when OBSERVER_PROVIDER=openai
OPENAI_BASE_URL=                     # default https://api.openai.com/v1
# Optional tuning (defaults shown; uncomment to change). An empty value is not the default, so keep them commented.
# SF_API_VERSION=v61.0
# SF_NOTE_EXCLUDE_SUBTYPES=Email,ListEmail          # Task subtypes that are not rep notes
# SF_ACCOUNT_WHERE=                                 # extra SOQL condition narrowing the accounts, e.g. Owner.UserRole.Name LIKE 'NA%'
# PEOPLE_DATES_MONTH_PADDED=1                       # 0 if your provider's dates are real days, not month starts
# PEOPLE_RATE_PER_SEC=5                             # people-data calls a second, shared by every worker (0 turns the limit off)
# PEOPLE_DEEP_LIMIT=5000                            # most same-name profiles pulled when the 50-deep search comes back full with nobody tied
# PEOPLE_EXPORT_URL=                                # optional bulk/export endpoint for that full pull (default: PEOPLE_SEARCH_URL)
# PEOPLE_PAST_COMPANY_FIELD=                        # only if your provider filters on work history: the field that takes a past employer
# OBSERVER_MAX_TURNS=2000                           # turns sent to the observer in one run
# OBSERVER_TEMPERATURE=0                            # openai path; empty sends none; a model that rejects it is asked once more without it
# OBSERVER_REASONING_EFFORT=                        # openai path, optional, e.g. low (reasoning.effort on OpenRouter, reasoning_effort elsewhere)
# GTM_HOME=                                         # installed wheel only: the folder holding config.json, contracts/ and sql/
# LEXICON_PATH=                                     # another lexicon file instead of contracts/lexicon.json
# REGRESSION_FILE=                                  # saved corrections for --check-regressions (default feedback/regression_cases.jsonl)
# PIPELINE_OUT=out                                  # the Slack app: where runs write (and where buttons read replay/)
# PIPELINE_TIMEOUT_S=3600                           # the Slack app: a run is stopped after this many seconds
